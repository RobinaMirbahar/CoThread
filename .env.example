# ============================================================================
# CoThread Enterprise AI Platform — Server Environment Configuration
# ============================================================================
# IMPORTANT: End users NEVER provide an API key!
# As the platform owner, drop your Gemini API key below. CoThread's server-side
# Quota Engine automatically allocates and enforces monthly token quotas for
# each signed-in user account based on their software subscription tier:
#   - Starter Tier (Default on Sign Up): 25,000 tokens / month
#   - Pro Tier:                          250,000 tokens / month
#   - Enterprise Tier:                   1,000,000 tokens / month
# ============================================================================

GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (defaults to 8080 for Google Cloud Run compatibility)
PORT=8080

# Optional Google OAuth Client ID for Google Identity Services Sign-In
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
